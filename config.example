# Конфиг host2ns — пример. Скопируйте в ~/.host2ns/config.
# NS — хост, где работает NSD с приёмником.
#     Формат: user@host или просто host (тогда берётся текущий пользователь).
NS=ilvin@ns.example.ru
# BASE — родительская зона; имена <запись>.<зона> станут <зона>.<BASE>.
# Задайте свой домен: встроенный дефолт в скриптах — iv77msk.ru.
BASE=example.ru
# FAMILY: список через запятую — ipv6, ipv4, nat (по умолчанию ipv6,ipv4)
# ipv6 — свои AAAA; ipv4 — свои A; nat — внешний IPv4 роутера.
FAMILY=ipv6,ipv4
